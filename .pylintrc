[MASTER]
init-hook=import sys; sys.path.insert(0, ".")
ignore-paths=tests
ignore=single_file_to_ignore.py
fail-under=8

[MESSAGE CONTROL]

disable=raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        use-symbolic-message-instead,
        missing-module-docstring,
        missing-function-docstring,
        missing-class-docstring,
        dangerous-default-value

[FORMAT]
max-line-length=120
[REFACTORING]

[DESIGN]
max-args=10